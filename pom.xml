<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.cocosoys.mc</groupId>
    <artifactId>CustomPanel</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>CustomPanel</name>

    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 主插件版本：运行时由服务器提供，编译期引用其同版本构建产物 -->
        <soys.version>1.4.1</soys.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.4</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- 关闭 dependency-reduced-pom.xml 生成：本项目所有依赖均为 provided/system scope
                         （Spigot、SOYSHTTPOverMC、MCERP、Lombok），无实际被打包的依赖，
                         生成的精简 POM 完全无意义，且每次 mvn package 都会污染项目根目录 -->
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                </configuration>
            </plugin>
        </plugins>
        <resources>
            <!-- 仅 plugin.yml 做属性过滤（${project.version}）；其余资源一律不过滤，
                 避免前端 dist 中的 ${...} 被误替换与拖慢构建 -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Spigot API 1.12.2：provided，运行时由服务端提供 -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.12.2-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- SOYSHTTPOverMC 1.4.1：硬依赖（plugin.yml depend），运行时由服务器提供；
             编译期引用其构建产物（1.12.2 shaded jar）。
             提供 HTTP-over-MC 网关、注解式 API 注册、页面托管、ORM 与鉴权能力。 -->
        <dependency>
            <groupId>com.github.cocosoys.mc</groupId>
            <artifactId>soyshttpovermc</artifactId>
            <version>${soys.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../SOYSHTTPOverMC/core/target/SOYSHTTPOverMC-1_12-${soys.version}.jar</systemPath>
        </dependency>

        <!-- MCERP：硬依赖（plugin.yml depend，定位为「纯 MCERP 模块」），运行时由服务器提供；
             编译期引用其构建产物（shaded jar）。
             面板的菜单、路由合成与侧边栏入口由 MCERP 中控提供，本插件经 McerpExpansion 登记。
             因 depend 已保证 MCERP 必在场，无需再写存在性探测与类加载隔离。 -->
        <dependency>
            <groupId>com.github.cocosoys.mc</groupId>
            <artifactId>MCERP</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../MCERP/target/MCERP-1.0-SNAPSHOT.jar</systemPath>
        </dependency>

        <!-- Lombok：编译期注解处理（@Data 实体 / @CustomLog 日志），不打包 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.30</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
